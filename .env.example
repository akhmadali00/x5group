# Bu fayl faqat namuna. Haqiqiy qiymatlar Vercel -> Settings -> Environment Variables ga kiritiladi.
# Hech qachon token va parollarni GitHub'ga yoki chatga yozmang.

# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543)
DATABASE_URL=

# @BotFather bergan token
TELEGRAM_BOT_TOKEN=
# O'zingiz o'ylab topgan uzun tasodifiy matn (webhook himoyasi)
TELEGRAM_WEBHOOK_SECRET=
# O'zingiz o'ylab topgan uzun tasodifiy matn (har daqiqalik eslatma chaqiruvi himoyasi)
CRON_SECRET=

# Ixtiyoriy
TELEGRAM_BOT_USERNAME=x5group_ai_bot
APP_URL=
# Zaxira faylidagi parol xeshlarini shifrlash uchun (kamida 16 belgi). Bo'lmasa fayl sirlarsiz bo'ladi.
BACKUP_KEY=
# AI yordamchi uchun (keyinroq)
ANTHROPIC_API_KEY=
