# Supabase: Project Settings -> API. Bularni FAQAT Vercel "Environment Variables"ga kiriting, hech kimga yubormang.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram: @BotFather bergan token
TELEGRAM_BOT_TOKEN=
# Webhook so'rovlarini tekshirish uchun o'zingiz o'ylab topgan uzun tasodifiy qator
TELEGRAM_WEBHOOK_SECRET=

# Supabase rejalashtiruvchisi (pg_cron) shu kalit bilan /api/cron/tick ni chaqiradi: uzun tasodifiy qator
CRON_SECRET=

# Sayt manzili (masalan https://x5group.vercel.app)
APP_URL=
